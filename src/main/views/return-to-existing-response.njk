{% extends "form/main/template.njk" %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block beforeContent %}
  {{ super() }}
  {% include "back-link.njk"%}
{% endblock %}

{% block content %}
	 {{
    govukErrorSummary({
      titleText: errorSummaryTitle,
      errorList: getErrors(form.fields)
    }) if getErrors(form.fields).length > 0
  }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">{{ title }}</h1>

      <h2 class="govuk-heading-m">{{ returnToDraft.heading }}</h2>
      <p class="govuk-body">{{ returnToDraft.intro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ returnToDraft.bullet1 }}</li>
        <li>{{ returnToDraft.bullet2 }}</li>
      </ul>

      <h2 class="govuk-heading-m">{{ returnToSubmitted.heading }}</h2>
      <p class="govuk-body">{{ returnToSubmitted.intro }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ returnToSubmitted.bullet1 }}</li>
        <li>{{ returnToSubmitted.bullet2 }}</li>
      </ul>

      {% block form %}
        {% include "form/form.njk"%}
      {% endblock %}

    </div>
  </div>
{% endblock %}
