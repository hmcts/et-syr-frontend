{% extends "form/main/template.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-7">{{ title }}</h1>
    <p class="govuk-body"><a href='{{newSelfAssignmentRequestUrl}}'>{{ p1 }}</a></p>
    {% if et3NotCompleted and et3NotCompleted.length != 0 %}
      <h2 class="govuk-heading-l">{{ table1Header }}</h2>
      <div class="app-responsive-table">
        <table class="govuk-table" role="table">
          <thead class="govuk-table__head" role="rowgroup">
            <tr class="govuk-table__row" role="row">
              <th scope="col" class="govuk-table__header" role="columnheader">{{ caseNumber }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ digitalReference }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ claimant }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ respondent }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ completionStatus }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ lastUpdated }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ options }}</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body" role="rowgroup">
            {% for et3NotCompletedRow in et3NotCompleted %}
              <tr class="govuk-table__row" role="row">
                <td class="govuk-table__cell" role="cell" data-label="{{ caseNumber }}"> {{ et3NotCompletedRow[1].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ digitalReference }}"> {{ et3NotCompletedRow[2].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ claimant }}"> {{ et3NotCompletedRow[3].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ respondent }}"> {{ et3NotCompletedRow[4].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ completionStatus }}"> {{ et3NotCompletedRow[5].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ lastUpdated }}"> {{ et3NotCompletedRow[6].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ options }}"> <a href="{{ et3NotCompletedRow[7].caseDetailsLink }}/{{ et3NotCompletedRow[7].caseId }}/{{ et3NotCompletedRow[7].respondentCcdId }}{{ languageParam }}" data-navigation-link aria-label="view {{ et3NotCompletedRow[1].text }}: {{ et3NotCompletedRow[7].caseId }}"> {{ continue }} </a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
    {% if et3Completed and et3Completed.length != 0 %}
      <h2 class="govuk-heading-l">{{ table2Header }}</h2>
      <div class="app-responsive-table">
        <table class="govuk-table" role="table">
          <thead class="govuk-table__head" role="rowgroup">
            <tr class="govuk-table__row" role="row">
              <th scope="col" class="govuk-table__header" role="columnheader">{{ dateSubmitted }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ caseNumber }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ digitalReference }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ claimant }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ respondent }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ lastUpdated }}</th>
              <th scope="col" class="govuk-table__header" role="columnheader">{{ options }}</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body" role="rowgroup">
            {% for et3CompletedRow in et3Completed %}
              <tr class="govuk-table__row" role="row">
                <td class="govuk-table__cell" role="cell" data-label="{{ dateSubmitted }}"> {{ et3CompletedRow[0].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ caseNumber }}"> {{ et3CompletedRow[1].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ digitalReference }}"> {{ et3CompletedRow[2].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ claimant }}"> {{ et3CompletedRow[3].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ respondent }}"> {{ et3CompletedRow[4].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ lastUpdated }}"> {{ et3CompletedRow[6].text }} </td>
                <td class="govuk-table__cell" role="cell" data-label="{{ options }}"> <a href="{{ et3CompletedRow[7].caseDetailsLink }}/{{ et3CompletedRow[7].caseId }}/{{ et3CompletedRow[7].respondentCcdId }}{{ languageParam }}" data-navigation-link aria-label="view {{ et3CompletedRow[1].text }}: {{ et3CompletedRow[7].caseId }}"> {{ continue }} </a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% endif %}
  </div>
</div>
{% endblock %}
